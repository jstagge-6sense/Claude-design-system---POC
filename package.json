{
  "name": "@6sense/design-system",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/**/*.d.ts",
    "dist/styles.css",
    "dist/tokens.json",
    "dist/tokens.d.ts",
    "dist/primitive.css",
    "dist/semantic.css",
    "dist/component.css",
    "dist/modes.css",
    "dist/modes.json",
    "README.md"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs .",
    "lint:tokens": "node scripts/lint-tokens.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:tokens && vite build",
    "storybook": "storybook dev -p 6006",
    "gen:storybook-guidelines": "node scripts/gen-storybook-guidelines.mjs",
    "build-storybook": "npm run build:tokens && storybook build -o storybook-static",
    "new:component": "node scripts/new-component.mjs",
    "check:components": "node scripts/check-components.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "gen:index": "node scripts/gen-index.mjs",
    "preview": "node scripts/build-preview.mjs",
    "tokens:apply": "node scripts/apply-token-edits.mjs",
    "build:modes": "node scripts/build-modes.mjs .",
    "build:lean": "node scripts/lean-tokens.mjs .",
    "publish:approved": "node scripts/publish.mjs",
    "preview:offline": "node scripts/build-preview.mjs --mini-react",
    "verify": "node scripts/verify-lib.mjs",
    "smoke:ssr": "node scripts/smoke-test.mjs --no-browser",
    "check:package": "node scripts/check-package.mjs",
    "codemod": "node scripts/codemod-tokens.mjs",
    "test:codemod": "node scripts/codemod-tokens.test.mjs",
    "build:pages": "npm run preview && npm run gen:storybook-guidelines && npm run build-storybook && node scripts/build-pages.mjs",
    "serve:pages": "npx serve pages-dist",
    "test:pages": "npm run build:pages && npm run serve:pages",
    "prepublishOnly": "npm run build && npm run verify && npm run smoke:ssr && npm run check:package"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@figma/code-connect": "latest",
    "@storybook/react-vite": "latest",
    "storybook": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-dts": "latest",
    "vitest": "latest",
    "esbuild": "^0.24.0"
  },
  "description": "6sense design system: tokens, React components and charts, driven by one set of design tokens.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstagge-6sense/Claude-design-system---POC.git"
  },
  "homepage": "https://github.com/jstagge-6sense/Claude-design-system---POC#readme",
  "keywords": ["design-system", "design-tokens", "react", "6sense"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "restricted" },
  "engines": { "node": ">=18" }
}
