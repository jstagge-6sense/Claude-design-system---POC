          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          }
        },
        "panel": {
