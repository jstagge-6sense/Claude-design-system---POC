{
  "component": {
    "menu": {
      "all": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.overlay}",
              "$description": "Menus sit on surface.overlay."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.standard},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%."
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.surface.medium}"
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.200}",
              "$description": "Elevation ladder step 200 for menus and listboxes."
            }
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "offset": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}",
            "$description": "Gap between trigger and panel."
          }
        },
        "slot": {
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}",
            "$description": "Search, header and footer slots."
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          }
        },
        "item": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.2}"
          },
          "fill": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.hover},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%. Also used for the keyboard-focused item."
            },
            "pressed": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.pressed},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%. Proposal: documented compact pressed is 4%, which reads lighter than hover on a flat row with no shadow cue."
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.action.selected}",
              "$description": "Gradient fill (a CSS image). Selected is a persistent state: fill plus a check mark, never shadow alone."
            }
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          },
          "label": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.primary}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              },
              "destructive": {
                "$type": "color",
                "$value": "{core.color.action.destructive.default}",
                "$description": "Red 600. Destructive action items. Always paired with the label text."
              }
            }
          },
          "description": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.help.1}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              }
            }
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              },
              "selected": {
                "$type": "color",
                "$value": "{core.color.content.primary}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          }
        },
        "group": {
          "label": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.label.1}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              }
            }
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          }
        },
        "divider": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.standard},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%."
            }
          }
        },
        "match": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.action.tint.hover},{core.effect.opacity.700})",
              "$description": "Teal 100 at 100%. Matching text is also bold, so color is never the only signal."
            }
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          }
        },
        "state": {
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Loading and empty messages."
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "check": {
          "size": {
            "$type": "sizing",
            "$value": "{component.checkbox.all.container.size}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{component.checkbox.all.container.radius}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{component.checkbox.all.container.borderWidth}"
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{component.checkbox.unchecked.container.fill.default}"
            },
            "selected": {
              "$type": "color",
              "$value": "{component.checkbox.checked.container.fill.default}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{component.checkbox.unchecked.container.fill.disabled}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{component.checkbox.unchecked.container.border.default}"
            },
            "selected": {
              "$type": "color",
              "$value": "{component.checkbox.checked.container.border.default}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{component.checkbox.unchecked.container.border.disabled}"
            }
          },
          "mark": {
            "color": {
              "selected": {
                "$type": "color",
                "$value": "{component.checkbox.checked.mark.color.default}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{component.checkbox.checked.mark.color.disabled}"
              }
            }
          }
        }
      }
    }
  }
}
