{
  "component": {
    "link": {
      "all": {
        "label": {
          "typographyInline": {
            "$type": "typography",
            "$value": "{core.typography.link.1}",
            "$description": "Inline link inside running text (narrative content)."
          },
          "typographyStandalone": {
            "$type": "typography",
            "$value": "{core.typography.link.2}",
            "$description": "Standalone and contextual UI link."
          },
          "color": {
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "container": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}",
            "$description": "Radius of the pressed tint and focus ring."
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          }
        }
      },
      "default": {
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.link.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.content.link.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.content.link.hover}",
              "$description": "Same ink as hover. Pressed is told apart by the container tint."
            },
            "visited": {
              "$type": "color",
              "$value": "{core.color.content.link.visited}"
            }
          }
        },
        "container": {
          "fill": {
            "pressed": {
              "$type": "color",
              "$value": "rgba({core.color.content.link.default},{core.effect.opacity.100})",
              "$description": "Link blue at 8%. Proposal: no documented pressed tint for links."
            }
          }
        }
      },
      "destructive": {
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.destructive.default}",
              "$description": "Red 600. No destructive content token exists. Nearest: core.color.status.critical."
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.destructive.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.action.destructive.hover}"
            }
          }
        },
        "container": {
          "fill": {
            "pressed": {
              "$type": "color",
              "$value": "rgba({core.color.action.destructive.default},{core.effect.opacity.100})",
              "$description": "Red 600 at 8%. Proposal."
            }
          }
        }
      }
    }
  }
}
