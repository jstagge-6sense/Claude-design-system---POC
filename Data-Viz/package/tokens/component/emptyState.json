{
  "component": {
    "emptyState": {
      "all": {
        "container": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}"
          },
          "paddingBlockCompact": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Used by the minimal and compact sizes."
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          }
        },
        "illustration": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.1200}",
            "$description": "Default illustration disc (48px). No semantic token for this size.",
            "$extensions": {
              "gap": "GAP-dimension-size-1200"
            }
          },
          "iconSize": {
            "$type": "sizing",
            "$value": "{core.dimension.size.500}",
            "$description": "Icon inside the default disc (24px). No semantic token.",
            "$extensions": {
              "gap": "GAP-dimension-size-500"
            }
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.full}",
            "$description": "Circle. No semantic token for full radius.",
            "$extensions": {
              "gap": "GAP-dimension-radius-full"
            }
          },
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.group}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          }
        },
        "title": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        },
        "description": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          }
        },
        "actions": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          }
        }
      },
      "error": {
        "illustration": {
          "fill": {
            "$type": "color",
            "$value": "rgba({core.color.status.critical},{core.effect.opacity.100})",
            "$description": "Critical at 8%. Proposal: no tinted status surface is documented."
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.status.critical}"
          }
        }
      },
      "minimal": {
        "title": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}",
            "$description": "Minimal (text only) uses a label style so it fits compact areas."
          }
        }
      }
    }
  }
}
