{
  "component": {
    "timePicker": {
      "all": {
        "panel": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.overlay}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.standard},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%. Also used for dividers inside the panel."
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.surface.medium}"
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.300}",
              "$description": "Elevation 300 for a menu-level surface (visual-design-decisions 5.6)."
            }
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "offset": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}",
            "$description": "Distance between the field and the panel."
          }
        },
        "group": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "option": {
          "height": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}",
            "$description": "Dense list row. 40px, near the 44px touch target; rows cannot overlap neighbours."
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          },
          "fill": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.hover},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%."
            },
            "pressed": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.pressed},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%. Proposal: the documented compact pressed value (4%) is too faint to read as feedback."
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.action.selected}",
              "$description": "Navigation Selected gradient (Sage 500 to Sage 400). Paired with a check icon so selection is never color alone."
            }
          },
          "border": {
            "active": {
              "$type": "color",
              "$value": "{core.color.border.focus}",
              "$description": "Keyboard-active option outline (aria-activedescendant). Focus stays in the input, so the option needs its own focus indicator."
            }
          },
          "borderWidthActive": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.200}",
            "$description": "2px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-200"
            }
          }
        },
        "segment": {
          "width": {
            "$type": "sizing",
            "$value": "{core.dimension.size.1200}",
            "$description": "Width of an hour, minute or second entry box (3rem).",
            "$extensions": {
              "gap": "GAP-dimension-size-1200"
            }
          },
          "height": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.control.default}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.control.default},{core.effect.opacity.600})",
              "$description": "Ink 900 at 64%, same as Input."
            },
            "focus": {
              "$type": "color",
              "$value": "{core.color.border.focus}"
            }
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          },
          "label": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.help.1}"
            },
            "color": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        }
      }
    }
  }
}
