{
  "component": {
    "drawer": {
      "all": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{component.dialog.all.container.fill}",
            "$description": "Same overlay surface as Dialog."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{component.dialog.all.container.radius}",
            "$description": "Applied to the corners that face the page only."
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{component.dialog.all.container.borderWidth}"
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.border.standard}",
            "$description": "Ink 900 at 16%. Drawer is a docked surface, so a standard edge replaces the Dialog highlight edge."
          },
          "shadow": {
            "$type": "shadow",
            "$value": "{core.effect.shadow.300}",
            "$description": "One step below Dialog on the elevation ladder."
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{component.dialog.all.container.paddingInline}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{component.dialog.all.container.paddingBlock}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{component.dialog.all.container.gap}"
          }
        },
        "scrim": {
          "fill": {
            "$type": "color",
            "$value": "{component.dialog.all.scrim.fill}",
            "$description": "Shown only when the drawer is modal."
          }
        },
        "header": {
          "gap": {
            "$type": "spacing",
            "$value": "{component.dialog.all.header.gap}"
          }
        },
        "title": {
          "typography": {
            "$type": "typography",
            "$value": "{component.dialog.all.title.typography}"
          },
          "color": {
            "$type": "color",
            "$value": "{component.dialog.all.title.color}"
          }
        },
        "leadIcon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}",
            "$description": "Optional lead icon in the header."
          }
        },
        "body": {
          "typography": {
            "$type": "typography",
            "$value": "{component.dialog.all.body.typography}"
          },
          "color": {
            "$type": "color",
            "$value": "{component.dialog.all.body.color}"
          }
        },
        "divider": {
          "color": {
            "$type": "color",
            "$value": "{component.dialog.all.divider.color}"
          }
        },
        "footer": {
          "gap": {
            "$type": "spacing",
            "$value": "{component.dialog.all.footer.gap}"
          }
        }
      }
    }
  }
}
