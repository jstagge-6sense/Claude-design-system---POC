{
  "component": {
    "sticky": {
      "all": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.card}",
            "$description": "Opaque surface so scrolling content never shows through a stuck element."
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px boundary stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "border": {
            "stuck": {
              "$type": "color",
              "$value": "rgba({core.color.border.standard},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%. Visible boundary shown only while stuck (Sticky Behavior rule 3)."
            }
          },
          "shadow": {
            "stuck": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.200}",
              "$description": "Elevation step 200 while stuck, so the element reads as sitting above scrolling content."
            }
          }
        }
      }
    }
  }
}
