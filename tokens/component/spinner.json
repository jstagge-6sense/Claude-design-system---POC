{
  "component": {
    "spinner": {
      "all": {
        "container": {
          "sizeSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}",
            "$description": "Inline and button spinner, 16px."
          },
          "sizeMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.medium}",
            "$description": "Section spinner, 24px."
          },
          "sizeLarge": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}",
            "$description": "Page spinner, 48px."
          },
          "strokeSmall": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.medium}"
          },
          "strokeLarge": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thick}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          }
        },
        "track": {
          "color": {
            "$type": "color",
            "$value": "{core.color.border.standard}",
            "$description": "Ink 900 at 16%."
          }
        },
        "arc": {
          "color": {
            "$type": "color",
            "$value": "{core.color.action.primary.default}"
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          }
        }
      },
      "overlay": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.scrim}",
            "$description": "Scrim. No scrim opacity is documented; 32% is a proposal. Tune in the preview."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.inverse}"
          }
        }
      },
      "onColor": {
        "track": {
          "color": {
            "$type": "color",
            "$value": "rgba({core.color.content.inverse},{core.effect.opacity.400})",
            "$description": "content.inverse at 32%. Track for spinners on filled surfaces such as primary and destructive buttons."
          }
        },
        "arc": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.inverse}",
            "$description": "content.inverse, matching the button label, for spinners on filled surfaces."
          }
        }
      }
    }
  }
}
