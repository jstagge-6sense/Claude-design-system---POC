{
  "component": {
    "fileUpload": {
      "all": {
        "zone": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.surface.medium}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.200}",
            "$description": "2px dashed zone edge.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-200"
            }
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.control.default}"
            },
            "dragOver": {
              "$type": "color",
              "$value": "{core.color.action.selected}",
              "$description": "Sage 500 to 400 gradient. Use as background, not background-color."
            },
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.surface.control.disabled},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.control.default},{core.effect.opacity.600})",
              "$description": "Ink 900 at 64% so the drop target passes 3:1."
            },
            "dragOver": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}",
              "$description": "Teal 700. Drag-over also changes the message text."
            },
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.border.disabled},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%."
            }
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          },
          "title": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.primary}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          },
          "hint": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          }
        },
        "error": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.critical}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          }
        },
        "list": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          }
        },
        "item": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}"
          },
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.card}",
            "$description": "Sage 100 to 200 gradient. Use as background."
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.standard},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%."
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}",
              "$description": "Error rows also carry an icon and message."
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "name": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.label.1}"
            },
            "color": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          },
          "meta": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.help.1}"
            },
            "color": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              },
              "success": {
                "$type": "color",
                "$value": "{core.color.status.success}"
              },
              "error": {
                "$type": "color",
                "$value": "{core.color.status.critical}"
              }
            }
          }
        }
      }
    }
  }
}
