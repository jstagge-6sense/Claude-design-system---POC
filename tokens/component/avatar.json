{
  "component": {
    "avatar": {
      "all": {
        "container": {
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          }
        },
        "label": {
          "typographyMedium": {
            "$type": "typography",
            "$value": "{core.typography.label.2}"
          },
          "typographyLarge": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "typographyXl": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}"
          }
        },
        "status": {
          "sizeSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.indicator.medium}",
            "$description": "8px status dot for small and medium avatars."
          },
          "sizeLarge": {
            "$type": "sizing",
            "$value": "{core.dimension.size.indicator.large}",
            "$description": "12px status dot for large and xl avatars."
          }
        }
      }
    }
  }
}
