{
  "component": {
    "banner": {
      "all": {
        "container": {
          "fillBase": {
            "$type": "color",
            "$value": "{core.color.surface.overlay}",
            "$description": "Opaque base under the severity tint, so the tint never depends on what is behind the banner."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}",
            "$description": "Page, section and inline placements. Global is square and edge to edge."
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "paddingInlineCompact": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}",
            "$description": "Inline placement."
          },
          "paddingBlockCompact": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}",
            "$description": "Inline placement."
          },
          "gapCompact": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}",
            "$description": "Inline placement."
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}",
              "$description": "Critical banners receive programmatic focus."
            }
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          }
        },
        "title": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        },
        "body": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        },
        "stack": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}",
            "$description": "Gap between banners in a BannerStack and its count control."
          }
        }
      },
      "info": {
        "container": {
          "fillTint": {
            "$type": "color",
            "$value": "rgba({core.color.status.info},{core.effect.opacity.100})",
            "$description": "Status info at 8%, layered over fillBase. Proposal: tinted status surfaces are not documented."
          },
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.info},{core.effect.opacity.500})",
            "$description": "Status info at 48%. Proposal."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.info}"
          }
        }
      },
      "success": {
        "container": {
          "fillTint": {
            "$type": "color",
            "$value": "rgba({core.color.status.success},{core.effect.opacity.100})",
            "$description": "Status success at 8%, layered over fillBase. Proposal: tinted status surfaces are not documented."
          },
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.success},{core.effect.opacity.500})",
            "$description": "Status success at 48%. Proposal."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.success}"
          }
        }
      },
      "warning": {
        "container": {
          "fillTint": {
            "$type": "color",
            "$value": "rgba({core.color.status.warning},{core.effect.opacity.100})",
            "$description": "Status warning at 8%, layered over fillBase. Proposal: tinted status surfaces are not documented."
          },
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.warning},{core.effect.opacity.500})",
            "$description": "Status warning at 48%. Proposal."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.warning}"
          }
        }
      },
      "error": {
        "container": {
          "fillTint": {
            "$type": "color",
            "$value": "rgba({core.color.status.critical},{core.effect.opacity.100})",
            "$description": "Status critical at 8%, layered over fillBase. Proposal: tinted status surfaces are not documented."
          },
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.critical},{core.effect.opacity.500})",
            "$description": "Status critical at 48%. Proposal."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.critical}"
          }
        }
      }
    }
  }
}
