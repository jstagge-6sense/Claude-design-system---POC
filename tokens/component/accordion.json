{
  "component": {
    "accordion": {
      "all": {
        "container": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.surface.medium}"
          },
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.group}",
            "$description": "Grouped container surface (Sage 200)."
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.border.group}",
            "$description": "Shared group border gradient. Use with a border-box background layer."
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "shadow": {
            "$type": "shadow",
            "$value": "{core.effect.shadow.formSection}"
          }
        },
        "item": {
          "divider": {
            "$type": "color",
            "$value": "rgba({core.color.border.subtle},{core.effect.opacity.100})",
            "$description": "Ink 900 at 8% between items."
          }
        },
        "header": {
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.heading.4}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          },
          "fill": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.hover},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%."
            }
          }
        },
        "description": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          }
        },
        "indicator": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "panel": {
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        },
        "toolbar": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          }
        }
      }
    }
  }
}
