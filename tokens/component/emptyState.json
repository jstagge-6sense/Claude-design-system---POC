{
  "component": {
    "emptyState": {
      "all": {
        "illustration": {
          "iconSize": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.medium}",
            "$description": "Icon inside the default disc (24px). No semantic token."
          }
        },
        "title": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}"
          }
        },
        "description": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          }
        }
      },
      "error": {
        "illustration": {
          "fill": {
            "$type": "color",
            "$value": "rgba({core.color.status.critical},{core.effect.opacity.100})",
            "$description": "Critical at 8%. Proposal: no tinted status surface is documented."
          }
        }
      },
      "minimal": {
        "title": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}",
            "$description": "Minimal (text only) uses a label style so it fits compact areas."
          }
        }
      }
    }
  }
}
