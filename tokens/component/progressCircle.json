{
  "component": {
    "progressCircle": {
      "all": {
        "track": {
          "color": {
            "$type": "color",
            "$value": "{component.progressBar.all.track.fill}"
          },
          "strokeSmall": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thick}",
            "$description": "4px ring for small."
          },
          "strokeMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.200}",
            "$description": "8px ring for standard.",
            "$extensions": {
              "gap": "GAP-dimension-size-200"
            }
          },
          "strokeLarge": {
            "$type": "sizing",
            "$value": "{core.dimension.size.300}",
            "$description": "12px ring for large.",
            "$extensions": {
              "gap": "GAP-dimension-size-300"
            }
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{component.progressBar.all.label.color}"
          },
          "typographySmall": {
            "$type": "typography",
            "$value": "{core.typography.label.2}"
          },
          "typographyMedium": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "typographyLarge": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}"
          }
        },
        "container": {
          "sizeSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}",
            "$description": "48px."
          },
          "scaleMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}",
            "$description": "Standard is 1.5x this 48px step (calc in CSS). No 72px primitive."
          },
          "scaleLarge": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}",
            "$description": "Large is 2x this 48px step (calc in CSS). No 96px primitive."
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{component.progressBar.all.icon.size}"
          }
        }
      },
      "default": {
        "fill": {
          "color": {
            "$type": "color",
            "$value": "{component.progressBar.default.fill.color}"
          }
        }
      },
      "complete": {
        "fill": {
          "color": {
            "$type": "color",
            "$value": "{component.progressBar.complete.fill.color}"
          }
        }
      },
      "error": {
        "fill": {
          "color": {
            "$type": "color",
            "$value": "{component.progressBar.error.fill.color}"
          }
        }
      }
    }
  }
}
