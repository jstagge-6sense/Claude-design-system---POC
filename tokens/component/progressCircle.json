{
  "component": {
    "progressCircle": {
      "all": {
        "track": {
          "color": {
            "$type": "color",
            "$value": "{core.color.border.standard}"
          },
          "strokeMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.indicator.medium}",
            "$description": "8px ring for standard."
          },
          "strokeLarge": {
            "$type": "sizing",
            "$value": "{core.dimension.size.indicator.large}",
            "$description": "12px ring for large."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          },
          "typographySmall": {
            "$type": "typography",
            "$value": "{core.typography.label.2}"
          },
          "typographyMedium": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "typographyLarge": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}"
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          }
        }
      },
      "default": {
        "fill": {
          "color": {
            "$type": "color",
            "$value": "{core.color.action.primary.default}"
          }
        }
      },
      "complete": {
        "fill": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.success}"
          }
        }
      },
      "error": {
        "fill": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.critical}"
          }
        }
      }
    }
  }
}
