{
  "component": {
    "formGroup": {
      "all": {
        "section": {
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.formSection}"
            }
          }
        },
        "legend": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}"
          }
        },
        "sectionDescription": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          }
        },
        "summary": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.status.critical},{core.effect.opacity.200})",
              "$description": "Critical at 16%. Proposal: no tinted status surface is documented (contract rule)."
            }
          },
          "title": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.label.1}"
            }
          },
          "link": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.link.2}"
            },
            "shadow": {
              "focus": {
                "$type": "shadow",
                "$value": "{core.effect.ring.focus}"
              }
            }
          }
        }
      }
    }
  }
}
