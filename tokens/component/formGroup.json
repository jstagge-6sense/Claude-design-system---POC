{
  "component": {
    "formGroup": {
      "all": {
        "container": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}",
            "$description": "Gap between summary, sections and footer."
          }
        },
        "field": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Single column is the default. Gap between fields."
          }
        },
        "row": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Two-column rows are for paired fields only (first/last name, city/state)."
          }
        },
        "section": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.card}",
              "$description": "Gradient (CSS image), use with `background`."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.group}",
              "$description": "Group border gradient, painted on the border-box."
            }
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.surface.medium}"
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}"
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.formSection}"
            }
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Gap between the legend, description and fields."
          }
        },
        "legend": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          }
        },
        "sectionDescription": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "inline": {
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Inline variant: settings rows inside page content, separated by a rule instead of a card."
          },
          "divider": {
            "width": {
              "$type": "borderWidth",
              "$value": "{core.dimension.borderWidth.thin}",
              "$description": "1px stroke. No semantic border width exists."
            }
          }
        },
        "footer": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "divider": {
            "color": {
              "$type": "color",
              "$value": "{core.color.border.standard}",
              "$description": "Ink 900 at 16%."
            }
          },
          "paddingBlockStart": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          }
        },
        "status": {
          "color": {
            "dirty": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "success": {
              "$type": "color",
              "$value": "{core.color.status.success}"
            },
            "submitting": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "summary": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.status.critical},{core.effect.opacity.200})",
              "$description": "Critical at 16%. Proposal: no tinted status surface is documented (contract rule)."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.medium}",
            "$description": "2px stroke. No semantic border width exists."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}"
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "title": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.label.1}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.primary}"
              }
            }
          },
          "icon": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.status.critical}"
              }
            },
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            }
          },
          "link": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.link.2}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.link.default}"
              },
              "hover": {
                "$type": "color",
                "$value": "{core.color.content.link.hover}"
              }
            },
            "shadow": {
              "focus": {
                "$type": "shadow",
                "$value": "{core.effect.ring.focus}"
              }
            }
          }
        },
        "wizard": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}",
            "$description": "Gap between the progress steps and the active step."
          }
        }
      }
    }
  }
}
