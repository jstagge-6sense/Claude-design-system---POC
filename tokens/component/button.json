{
  "component": {
    "button": {
      "all": {
        "container": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}"
          },
          "heightSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.small}"
          },
          "heightMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}"
          },
          "heightLarge": {
            "$type": "sizing",
            "$value": "{core.dimension.size.1200}",
            "$description": "Large button height (48px). No semantic token for a large control height.",
            "$extensions": {
              "gap": "GAP-dimension-size-1200"
            }
          },
          "paddingInlineSmall": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "paddingInlineMedium": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "paddingInlineLarge": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}"
          },
          "gapSmall": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "gapMedium": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "fill": {
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.action.disabled.fill},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%. Semantic token is solid Ink 900, opacity composed here per visual-design-decisions 4.1."
            }
          },
          "border": {
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.action.disabled.border},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%."
            }
          }
        },
        "label": {
          "typographySmall": {
            "$type": "typography",
            "$value": "{core.typography.button.2}"
          },
          "typographyLarge": {
            "$type": "typography",
            "$value": "{core.typography.button.1}",
            "$description": "No large button typography style exists. Reuses button.1."
          },
          "color": {
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          },
          "color": {
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        }
      },
      "primary": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.primary.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.action.primary.pressed}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.subtle},{core.effect.opacity.0})",
              "$description": "Transparent. Primary has no documented stroke."
            }
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.primary.default}"
            },
            "hover": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.primary.hover}"
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.primary.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.primary.focus}"
            }
          }
        },
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            }
          }
        },
        "icon": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            }
          }
        }
      },
      "secondary": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.secondary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.secondary.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.action.secondary.pressed}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.standard},{core.effect.opacity.200})"
            }
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.secondary.default}"
            },
            "hover": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.secondary.hover}"
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.secondary.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.secondary.focus}"
            }
          },
          "fillTint": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.tint.hover},{core.effect.opacity.200})",
              "$description": "Teal 100 at 16%, layered over the Sage 400 fill on hover."
            }
          }
        },
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.teal.900}",
              "$description": "Documented as Teal 900 (visual-design-decisions 4.3, 4.4). No semantic content token for it. Nearest semantic: core.color.content.primary.",
              "$extensions": {
                "gap": "GAP-button-1"
              }
            }
          }
        },
        "icon": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.teal.900}",
              "$description": "Matches label color.",
              "$extensions": {
                "gap": "GAP-button-1"
              }
            }
          }
        }
      },
      "tertiary": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.tertiary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.tertiary.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.action.tertiary.pressed}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.subtle},{core.effect.opacity.100})"
            }
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.tertiary.default}"
            },
            "hover": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.tertiary.hover}"
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.tertiary.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.tertiary.focus}"
            }
          }
        },
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.teal.900}",
              "$description": "Documented as Teal 900 (visual-design-decisions 4.3, 4.4). No semantic content token for it. Nearest semantic: core.color.content.primary.",
              "$extensions": {
                "gap": "GAP-button-1"
              }
            }
          }
        },
        "icon": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.teal.900}",
              "$description": "Matches label color.",
              "$extensions": {
                "gap": "GAP-button-1"
              }
            }
          }
        }
      },
      "destructive": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.destructive.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.destructive.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.action.destructive.pressed}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.destructive},{core.effect.opacity.100})"
            }
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.destructive.default}"
            },
            "hover": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.destructive.hover}"
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.destructive.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.destructive.focus}"
            }
          }
        },
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            }
          }
        },
        "icon": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            }
          }
        }
      }
    }
  }
}
