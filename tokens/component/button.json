        },
        "icon": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.brand}",
              "$description": "Matches label color."
            }
          }
        }
      },
      "destructive": {
        "container": {
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.destructive},{core.effect.opacity.100})"
