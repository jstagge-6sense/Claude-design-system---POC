{
  "component": {
    "table": {
      "all": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.card}"
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.border.standard}",
            "$description": "Ink 900 at 16%."
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}",
            "$description": "1px stroke."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.surface.medium}"
          },
          "shadow": {
            "$type": "shadow",
            "$value": "{core.effect.shadow.card}"
          }
        },
        "header": {
          "fill": {
            "$type": "color",
            "$value": "rgba({core.color.action.compact.default},{core.effect.opacity.50})",
            "$description": "Ink 900 at 4% (opacity ladder, header row fill). Layered over the container fill in CSS so a sticky header stays opaque."
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          },
          "button": {
            "fill": {
              "hover": {
                "$type": "color",
                "$value": "{core.color.action.compact.hover}",
                "$description": "Ink 900 at 8% behind a hovered sort button."
              }
            }
          },
          "sortIcon": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              },
              "active": {
                "$type": "color",
                "$value": "{core.color.content.primary}"
              }
            }
          }
        },
        "cell": {
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "paddingInlineDense": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          }
        },
        "cellPrimary": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.table.cellPrimary}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        },
        "cellSecondary": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.table.cellSecondary}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}",
            "$description": "Secondary text is de-emphasized by color and size, not weight."
          }
        },
        "row": {
          "heightDefault": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}",
            "$description": "Default row height (48px). No semantic token for this size."
          },
          "heightDense": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.small}",
            "$description": "Dense row height (32px)."
          },
          "divider": {
            "$type": "color",
            "$value": "{core.color.border.subtle}",
            "$description": "Ink 900 at 8%."
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.card}"
            },
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.default},{core.effect.opacity.50})",
              "$description": "Ink 900 at 4%, layered over the default fill."
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.action.selected}",
              "$description": "Selected gradient fill (Sage 500 to Sage 400)."
            },
            "error": {
              "$type": "color",
              "$value": "rgba({core.color.status.critical},{core.effect.opacity.50})",
              "$description": "Critical at 4%. Proposal: no tinted status surface is documented."
            }
          },
          "accent": {
            "color": {
              "selected": {
                "$type": "color",
                "$value": "{core.color.action.primary.default}",
                "$description": "Accent bar on the start edge of a selected row, so selection is not color-fill alone."
              }
            },
            "width": {
              "$type": "borderWidth",
              "$value": "{core.dimension.borderWidth.medium}",
              "$description": "2px accent bar."
            }
          },
          "error": {
            "color": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          }
        },
        "detail": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.group}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}"
          }
        },
        "control": {
          "columnWidth": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}",
            "$description": "Width of the selection and expand columns (48px)."
          }
        },
        "editor": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.control.default}"
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.border.control.default}",
            "$description": "Ink 900 at 64% (functional border)."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          },
          "hint": {
            "color": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "footer": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.card}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.footer.1}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          }
        },
        "sticky": {
          "border": {
            "stuck": {
              "$type": "color",
              "$value": "{component.sticky.all.container.border.stuck}",
              "$description": "Boundary under a stuck header or beside a stuck first column. Aliases Sticky."
            }
          },
          "shadow": {
            "stuck": {
              "$type": "shadow",
              "$value": "{component.sticky.all.container.shadow.stuck}",
              "$description": "Aliases Sticky."
            }
          }
        }
      }
    }
  }
}
