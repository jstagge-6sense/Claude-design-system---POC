{
  "component": {
    "codeSnippet": {
      "all": {
        "code": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.code.1}",
            "$description": "Code text. Monospace via core.typography.code.1."
          }
        },
        "copy": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.default},{core.effect.opacity.50})",
              "$description": "Ink 900 at 4% (Inline Icon Action, visual-design-decisions 4.6)."
            },
            "pressed": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.pressed},{core.effect.opacity.50})",
              "$description": "Ink 900 at 4%, matches default."
            }
          },
          "shadow": {
            "hover": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.navigation.hover}"
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.navigation.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.navigation.focus}"
            }
          }
        }
      }
    }
  }
}
