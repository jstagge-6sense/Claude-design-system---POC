{
  "component": {
    "datePicker": {
      "all": {
        "panel": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{component.timePicker.all.panel.fill.default}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{component.timePicker.all.panel.border.default}"
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{component.timePicker.all.panel.borderWidth}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{component.timePicker.all.panel.radius}"
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{component.timePicker.all.panel.shadow.default}"
            }
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Calendar panel is roomier than the time list (standard, not tight)."
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "offset": {
            "$type": "spacing",
            "$value": "{component.timePicker.all.panel.offset}"
          }
        },
        "header": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          }
        },
        "weekday": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "day": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}",
            "$description": "Visual size of the day. The grid cell is 44px (--ds-hit-min) so the hit area is met."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "outside": {
              "$type": "color",
              "$value": "{core.color.content.placeholder}",
              "$description": "Days from the previous or next month."
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}",
              "$description": "Disabled dates are also struck through so they are not color alone."
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            },
            "range": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          },
          "fill": {
            "hover": {
              "$type": "color",
              "$value": "{component.timePicker.all.option.fill.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{component.timePicker.all.option.fill.pressed}"
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}",
              "$description": "Start, end and single-selected day. Teal 700, with inverse text."
            },
            "range": {
              "$type": "color",
              "$value": "rgba({core.color.action.tint.hover},{core.effect.opacity.400})",
              "$description": "Teal 100 at 32%. Proposal: no documented in-range color. Range also carries start and end marks, not color alone."
            }
          },
          "border": {
            "today": {
              "$type": "color",
              "$value": "rgba({core.color.border.control.default},{core.effect.opacity.600})",
              "$description": "Ink 900 at 64%. Today is outlined so it is visible with or without a selection."
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          }
        },
        "note": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "preset": {
          "height": {
            "$type": "sizing",
            "$value": "{component.timePicker.all.option.height}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{component.timePicker.all.option.paddingInline}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{component.timePicker.all.option.radius}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{component.timePicker.all.option.typography}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{component.timePicker.all.option.color.default}"
            }
          },
          "fill": {
            "hover": {
              "$type": "color",
              "$value": "{component.timePicker.all.option.fill.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{component.timePicker.all.option.fill.pressed}"
            },
            "selected": {
              "$type": "color",
              "$value": "{component.timePicker.all.option.fill.selected}"
            }
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          }
        }
      }
    }
  }
}
