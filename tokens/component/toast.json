{
  "component": {
    "toast": {
      "all": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.overlay}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}",
            "$description": "1px stroke. No semantic border width exists."
          },
          "shadow": {
            "$type": "shadow",
            "$value": "{core.effect.shadow.300}",
            "$description": "Floating, non-blocking. One step below Dialog."
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}",
            "$description": "Gap between icon, message and the action or close control."
          }
        },
        "viewport": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}",
            "$description": "Gap between stacked toasts."
          },
          "inset": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Distance from the viewport or frame edge."
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          }
        },
        "title": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        },
        "description": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          }
        }
      },
      "info": {
        "container": {
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.info},{core.effect.opacity.500})",
            "$description": "Status info at 48%. Proposal: no documented toast stroke. The icon and text also carry the severity."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.info}"
          }
        }
      },
      "success": {
        "container": {
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.success},{core.effect.opacity.500})",
            "$description": "Status success at 48%. Proposal: no documented toast stroke. The icon and text also carry the severity."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.success}"
          }
        }
      },
      "warning": {
        "container": {
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.warning},{core.effect.opacity.500})",
            "$description": "Status warning at 48%. Proposal: no documented toast stroke. The icon and text also carry the severity."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.warning}"
          }
        }
      },
      "error": {
        "container": {
          "border": {
            "$type": "color",
            "$value": "rgba({core.color.status.critical},{core.effect.opacity.500})",
            "$description": "Status critical at 48%. Proposal: no documented toast stroke. The icon and text also carry the severity."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.critical}"
          }
        }
      }
    }
  }
}
