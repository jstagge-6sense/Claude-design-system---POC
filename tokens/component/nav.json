{
  "component": {
    "nav": {
      "all": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.card}",
              "$description": "Sidebar surface. Gradient (CSS image), use with `background`."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.standard},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%. Divider on the edge facing the content."
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}",
            "$description": "Gap between items."
          },
          "groupGap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Gap between groups."
          },
          "shadow": {
            "overlay": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.300}",
              "$description": "Elevation when the nav opens as an overlay on mobile (menu tier)."
            }
          }
        },
        "item": {
          "height": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}",
            "$description": "12px, shares the button shape language (visual-design-decisions 4.5)."
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "indent": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}",
            "$description": "Start indent for second-level items. Two levels maximum."
          },
          "label": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.nav.primary}"
            },
            "typographyNested": {
              "$type": "typography",
              "$value": "{core.typography.nav.secondary}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              },
              "selected": {
                "$type": "color",
                "$value": "{core.color.content.primary}",
                "$description": "Selected is a fill change plus a stronger label color and aria-current. Not shadow alone."
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              },
              "selected": {
                "$type": "color",
                "$value": "{core.color.action.primary.default}",
                "$description": "Teal 700 icon marks the current page in addition to the fill."
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.default},{core.effect.opacity.50})",
              "$description": "Ink 900 at 4%. Decorative consistency device, not an affordance signal (visual-design-decisions 4.5)."
            },
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.hover},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%."
            },
            "pressed": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.pressed},{core.effect.opacity.50})",
              "$description": "Ink 900 at 4%. Matches default, not hover (non-monotonic ladder, by design)."
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.action.selected}",
              "$description": "Gradient fill (Sage 500 to Sage 400), no border. Gradient: use `background`."
            }
          },
          "border": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.border.subtle},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%."
            }
          },
          "shadow": {
            "hover": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.navigation.hover}",
              "$description": "Insets only. Followed as in the token JSON (the inset order described in visual-design-decisions conflict 1 is reversed)."
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.navigation.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.navigation.focus}"
            }
          }
        },
        "group": {
          "label": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.label.2}"
            },
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.secondary}"
              }
            }
          }
        },
        "tooltip": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}",
              "$description": "Ink 900 surface behind the rail tooltip."
            }
          },
          "label": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{core.color.content.inverse}"
              }
            }
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "offset": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.200}"
            }
          }
        }
      }
    }
  }
}
