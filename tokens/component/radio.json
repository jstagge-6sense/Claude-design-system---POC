{
  "component": {
    "radio": {
      "all": {
        "container": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{component.checkbox.all.container.shadow.focus}"
            }
          }
        },
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "description": {
          "typography": {
            "$type": "typography",
            "$value": "{component.checkbox.all.description.typography}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "error": {
          "typography": {
            "$type": "typography",
            "$value": "{component.checkbox.all.error.typography}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          }
        },
        "legend": {
          "typography": {
            "$type": "typography",
            "$value": "{component.checkbox.all.legend.typography}"
          }
        },
        "group": {
          "gapVertical": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "gapHorizontal": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}"
          }
        }
      },
      "unchecked": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.control.default}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.surface.control.disabled}"
            }
          },
          "fillTint": {
            "hover": {
              "$type": "color",
              "$value": "{component.checkbox.unchecked.container.fillTint.hover}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.control.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{component.checkbox.unchecked.container.border.hover}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.border.disabled}"
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          }
        }
      },
      "checked": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.primary.hover}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{component.checkbox.checked.container.fill.disabled}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.primary.hover}"
            }
          }
        },
        "mark": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            }
          }
        }
      }
    }
  }
}
