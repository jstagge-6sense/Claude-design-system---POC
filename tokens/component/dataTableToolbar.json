          },
          "shadow": {
            "$type": "shadow",
            "$value": "{core.effect.shadow.300}",
            "$description": "Elevation step 300 for the in-place column panel."
          },
          "divider": {
            "$type": "color",
            "$value": "{core.color.border.subtle}"
          }
        }
      }
