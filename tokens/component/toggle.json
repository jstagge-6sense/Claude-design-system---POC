{
  "component": {
    "toggle": {
      "all": {
        "container": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.pill}",
            "$description": "Pill or circle radius. No semantic token for a full radius."
          },
          "widthMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.1000}",
            "$description": "40px. No semantic size.",
            "$extensions": {
              "gap": "GAP-dimension-size-1000"
            }
          },
          "heightMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.medium}",
            "$description": "24px. No semantic size."
          },
          "widthSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.800}",
            "$description": "32px. No semantic size.",
            "$extensions": {
              "gap": "GAP-dimension-size-800"
            }
          },
          "heightSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}",
            "$description": "1px stroke. No semantic border width exists."
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          }
        },
        "thumb": {
          "sizeMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          },
          "sizeSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.300}",
            "$description": "12px. No semantic size.",
            "$extensions": {
              "gap": "GAP-dimension-size-300"
            }
          }
        },
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "description": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        }
      },
      "off": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.group}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.surface.control.disabled}",
              "$description": "Ink 900 at 8% (conflict C-1)."
            }
          },
          "fillTint": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.tint.hover},{core.effect.opacity.200})"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.control.default}",
              "$description": "Ink 900 at 64%."
            },
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.default},{core.effect.opacity.700})"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.border.disabled}"
            }
          }
        },
        "thumb": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.control.default}",
              "$description": "Ink 900 at 64%."
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        }
      },
      "on": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}",
              "$description": "On state: color change plus thumb position."
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.primary.hover}"
            },
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.action.disabled.border},{core.effect.opacity.300})",
              "$description": "Ink 900 at 24%."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.primary.hover}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.border.disabled}"
            }
          }
        },
        "thumb": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.surface.control.default}"
            }
          }
        }
      }
    }
  }
}
