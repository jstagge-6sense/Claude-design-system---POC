{
  "component": {
    "infiniteScroll": {
      "all": {
        "status": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "paddingBlock": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            }
          }
        },
        "count": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            }
          }
        },
        "skeleton": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          }
        },
        "footer": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.overlay}",
              "$description": "Pinned footer slot stays reachable while content keeps loading."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.standard}",
              "$description": "Ink 900 at 16%."
            }
          },
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          }
        },
        "end": {
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.subtle}",
              "$description": "Ink 900 at 8%. Hairline above the end-of-content indicator."
            }
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}",
            "$description": "1px stroke. No semantic border width exists."
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}",
              "$description": "Ring when focus is placed on the end indicator after Load more was activated."
            }
          }
        }
      }
    }
  }
}
