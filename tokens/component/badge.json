{
  "component": {
    "badge": {
      "all": {
        "container": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.pill}",
            "$description": "Pill or circle radius. No semantic token for full radius."
          },
          "heightMin": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.medium}",
            "$description": "Minimum height, 24px. Count badges use it as their minimum width so one digit is a circle."
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}",
            "$description": "1px stroke. No semantic border width exists."
          }
        },
        "label": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.2}"
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          }
        }
      },
      "critical": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.badge.critical}"
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.surface.badge.critical}",
            "$description": "Same as the fill so every tone keeps one box size."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.inverse}"
          }
        }
      },
      "warning": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.badge.warning}"
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.surface.badge.warning}",
            "$description": "Same as the fill so every tone keeps one box size."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.inverse}"
          }
        }
      },
      "success": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.badge.success}"
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.surface.badge.success}",
            "$description": "Same as the fill so every tone keeps one box size."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.inverse}"
          }
        }
      },
      "info": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.status.info}",
            "$description": "Ink 800. Info has no badge surface token; reuses the info status color."
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.status.info}",
            "$description": "Same as the fill so every tone keeps one box size."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.inverse}"
          }
        }
      },
      "accent": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.action.primary.default}",
            "$description": "Teal 700. Used by new and beta monikers. Proposal."
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.action.primary.default}",
            "$description": "Same as the fill so every tone keeps one box size."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.inverse}"
          }
        }
      },
      "neutral": {
        "container": {
          "fill": {
            "$type": "color",
            "$value": "{core.color.surface.chip}"
          },
          "border": {
            "$type": "color",
            "$value": "{core.color.border.strong}",
            "$description": "Ink 900 at 24%. Assumption per contract table (border.strong)."
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        }
      }
    }
  }
}
