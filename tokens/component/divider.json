{
  "component": {
    "divider": {
      "all": {
        "line": {
          "thickness": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}",
            "$description": "1px stroke. No semantic border width exists."
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.border.standard}",
            "$description": "Ink 900 at 16%."
          }
        },
        "container": {
          "insetStart": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Indent for inset dividers so the line aligns with content, not the container edge."
          }
        },
        "label": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.2}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}",
            "$description": "Space between the label and the line segments."
          }
        }
      }
    }
  }
}
