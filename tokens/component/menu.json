{
  "component": {
    "menu": {
      "all": {
        "container": {
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{core.effect.shadow.200}",
              "$description": "Elevation ladder step 200 for menus and listboxes."
            }
          }
        },
        "item": {
          "fill": {
            "pressed": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.pressed},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%. Proposal: documented compact pressed is 4%, which reads lighter than hover on a flat row with no shadow cue."
            }
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          },
          "description": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.help.1}"
            }
          }
        },
        "group": {
          "label": {
            "typography": {
              "$type": "typography",
              "$value": "{core.typography.label.1}"
            }
          }
        },
        "match": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.action.tint.hover},{core.effect.opacity.700})",
              "$description": "Teal 100 at 100%. Matching text is also bold, so color is never the only signal."
            }
          }
        },
        "check": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}"
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.control.default}"
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.surface.control.disabled}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.control.default}"
            },
            "selected": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.border.disabled}"
            }
          },
          "mark": {
            "color": {
              "selected": {
                "$type": "color",
                "$value": "{core.color.content.inverse}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          }
        }
      }
    }
  }
}
