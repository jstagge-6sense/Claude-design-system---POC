{
  "component": {
    "breadcrumb": {
      "all": {
        "container": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}",
            "$description": "Gap between an item and its separator."
          }
        },
        "link": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.2}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.content.link.hover}"
            }
          },
          "fill": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.hover},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%."
            }
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          }
        },
        "current": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          }
        },
        "separator": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.placeholder}"
            }
          },
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}",
            "$description": "Home icon size."
          }
        }
      }
    }
  }
}
