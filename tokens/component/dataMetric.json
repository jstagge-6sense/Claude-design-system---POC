{
  "component": {
    "dataMetric": {
      "all": {
        "container": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "gapInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}",
            "$description": "Gap between the value and trend or sparkline on one row."
          }
        },
        "label": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          }
        },
        "value": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.metric.1}"
          },
          "typographyCompact": {
            "$type": "typography",
            "$value": "{core.typography.heading.3}",
            "$description": "No compact metric style exists. Nearest semantic: heading.3."
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.primary}"
          }
        },
        "trend": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}"
          },
          "iconSize": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          }
        },
        "comparison": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}"
          }
        },
        "sparkline": {
          "height": {
            "$type": "sizing",
            "$value": "{core.dimension.size.800}",
            "$description": "32px sparkline height.",
            "$extensions": {
              "gap": "GAP-dimension-size-800"
            }
          },
          "width": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}",
            "$description": "Base unit for sparkline width. CSS doubles it (96px). 48px primitive."
          },
          "strokeWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.medium}",
            "$description": "2px line."
          },
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}",
            "$description": "Neutral line so the trend text carries the meaning."
          }
        },
        "error": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.critical}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          }
        }
      },
      "positive": {
        "trend": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.success}",
            "$description": "Favorable change. Always paired with an arrow icon and text."
          }
        }
      },
      "negative": {
        "trend": {
          "color": {
            "$type": "color",
            "$value": "{core.color.status.critical}",
            "$description": "Unfavorable change. Always paired with an arrow icon and text."
          }
        }
      },
      "neutral": {
        "trend": {
          "color": {
            "$type": "color",
            "$value": "{core.color.content.secondary}",
            "$description": "No change or no judgement. Paired with a dash icon and text."
          }
        }
      }
    }
  }
}
