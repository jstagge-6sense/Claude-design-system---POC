{
  "component": {
    "checkbox": {
      "all": {
        "container": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}",
            "$description": "Control box, 16px."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.100}",
            "$description": "1px stroke. No semantic border width exists.",
            "$extensions": {
              "gap": "GAP-dimension-borderWidth-100"
            }
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}",
            "$description": "Gap between the control and its label."
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          }
        },
        "label": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "description": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "error": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          }
        },
        "legend": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          }
        },
        "group": {
          "gapVertical": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "gapHorizontal": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}",
            "$description": "Horizontal spacing minimum is an open question in the requirements. 24px is an assumption."
          }
        }
      },
      "unchecked": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.control.default}"
            },
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.surface.control.disabled},{core.effect.opacity.100})",
              "$description": "Ink 900 at 8%. Semantic token is solid, opacity composed here (conflict C-1)."
            }
          },
          "fillTint": {
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.tint.hover},{core.effect.opacity.200})",
              "$description": "Teal 100 at 16%, layered over the default fill on hover."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "rgba({core.color.border.control.default},{core.effect.opacity.600})",
              "$description": "Ink 900 at 64% (control border, 3:1)."
            },
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.border.control.default},{core.effect.opacity.700})",
              "$description": "Control border at full strength on hover."
            },
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.border.disabled},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%."
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          }
        }
      },
      "checked": {
        "container": {
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}",
              "$description": "Checked and indeterminate. Persistent state: color change."
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.primary.hover}"
            },
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.action.disabled.fill},{core.effect.opacity.200})",
              "$description": "Ink 900 at 16%, so a disabled checked box differs from a disabled unchecked box (8%)."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.primary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.primary.hover}"
            },
            "disabled": {
              "$type": "color",
              "$value": "rgba({core.color.border.disabled},{core.effect.opacity.200})"
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          }
        },
        "mark": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.inverse}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        }
      }
    }
  }
}
