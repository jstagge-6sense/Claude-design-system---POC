{
  "component": {
    "buttonGroup": {
      "all": {
        "container": {
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}",
            "$description": "Outer corners only. Inner corners are square."
          }
        },
        "segment": {
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}"
          },
          "heightSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.small}"
          },
          "paddingInlineSmall": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "typographySmall": {
            "$type": "typography",
            "$value": "{component.button.all.label.typographySmall}"
          },
          "heightMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}"
          },
          "paddingInlineMedium": {
            "$type": "spacing",
            "$value": "{core.dimension.space.standard}"
          },
          "heightLarge": {
            "$type": "sizing",
            "$value": "{core.dimension.size.feedback.large}"
          },
          "paddingInlineLarge": {
            "$type": "spacing",
            "$value": "{core.dimension.space.spacious}"
          },
          "typographyLarge": {
            "$type": "typography",
            "$value": "{component.button.all.label.typographyLarge}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            }
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.secondary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.secondary.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.action.secondary.pressed}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{component.button.all.container.fill.disabled}"
            }
          },
          "fillTint": {
            "hover": {
              "$type": "color",
              "$value": "{component.button.secondary.container.fillTint.hover}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.standard}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{component.button.all.container.border.disabled}"
            }
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{component.button.secondary.container.shadow.default}"
            },
            "hover": {
              "$type": "shadow",
              "$value": "{component.button.secondary.container.shadow.hover}"
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{component.button.secondary.container.shadow.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{component.button.secondary.container.shadow.focus}"
            },
            "selected": {
              "$type": "shadow",
              "$value": "{component.button.secondary.container.shadow.pressed}",
              "$description": "Recessed look. Never the only cue."
            }
          },
          "label": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{component.button.secondary.label.color.default}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          }
        }
      }
    }
  }
}
