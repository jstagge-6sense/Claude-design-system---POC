{
  "component": {
    "input": {
      "all": {
        "shell": {
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}",
            "$description": "Gap between label, field and helper text."
          }
        },
        "container": {
          "heightSmall": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.small}"
          },
          "heightMedium": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}"
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}"
          },
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}",
            "$description": "1px stroke. No semantic border width exists."
          },
          "paddingInline": {
            "$type": "spacing",
            "$value": "{core.dimension.space.comfortable}"
          },
          "gap": {
            "$type": "spacing",
            "$value": "{core.dimension.space.compact}"
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.surface.control.default}"
            },
            "readOnly": {
              "$type": "color",
              "$value": "{core.color.surface.control.readOnly}",
              "$description": "Sage 200. Read-only is distinct from disabled: it keeps full-contrast text and a lock icon."
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.surface.control.disabled}",
              "$description": "Ink 900 at 8%. Semantic token is solid Ink 900, opacity composed here (conflict C-1)."
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.control.default}",
              "$description": "Ink 900 at 64%. Passes 3:1 for UI components (visual-design-decisions 2.3)."
            },
            "hover": {
              "$type": "color",
              "$value": "rgba({core.color.action.compact.default},{core.effect.opacity.700})",
              "$description": "Ink 900 at 100%. Hover darkens the stroke from 64% to 100%. Proposal: no hover treatment is documented."
            },
            "focus": {
              "$type": "color",
              "$value": "{core.color.border.focus}",
              "$description": "Blue 600, under the focus ring."
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}",
              "$description": "Red 500 (status.critical). Always paired with an error icon and message so color is never the only signal. Red usage for form validation is not yet documented; proposal."
            },
            "readOnly": {
              "$type": "color",
              "$value": "{core.color.border.standard}",
              "$description": "Ink 900 at 16%. Quieter stroke than an editable field."
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.border.disabled}",
              "$description": "Ink 900 at 16%."
            }
          },
          "shadow": {
            "focus": {
              "$type": "shadow",
              "$value": "{core.effect.ring.focus}"
            }
          }
        },
        "text": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "placeholder": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.placeholder}",
              "$description": "Ink 700. Example input only, never instructions."
            }
          }
        },
        "icon": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.icon}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            }
          }
        },
        "action": {
          "padding": {
            "$type": "spacing",
            "$value": "{core.dimension.space.tight}",
            "$description": "Visual padding around inline action icons (clear, visibility toggle). The 44px hit area is added by a pseudo-element."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.small}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            }
          },
          "fill": {
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.compact.hover}",
              "$description": "Ink 900 at 8%, the compact action hover background."
            }
          }
        },
        "label": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.label.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.primary}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          },
          "indicatorColor": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}",
              "$description": "The \"(optional)\" and \"(required)\" text marker. Written text, never color alone."
            }
          }
        },
        "helper": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.help.1}"
          },
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "error": {
              "$type": "color",
              "$value": "{core.color.status.critical}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{core.color.content.disabled}"
            }
          }
        },
        "counter": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.content.secondary}"
            },
            "limit": {
              "$type": "color",
              "$value": "{core.color.status.critical}",
              "$description": "Counter at its limit."
            }
          }
        }
      }
    }
  }
}
