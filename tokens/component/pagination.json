{
  "component": {
    "pagination": {
      "all": {
        "container": {
          "borderWidth": {
            "$type": "borderWidth",
            "$value": "{core.dimension.borderWidth.thin}"
          }
        },
        "page": {
          "size": {
            "$type": "sizing",
            "$value": "{core.dimension.size.control.height.medium}",
            "$description": "Visual size of a page control. The hit area grows to 44px."
          },
          "radius": {
            "$type": "borderRadius",
            "$value": "{core.dimension.radius.control.medium}"
          },
          "typography": {
            "$type": "typography",
            "$value": "{component.button.all.label.typographyLarge}"
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{core.dimension.size.icon}"
            }
          },
          "fill": {
            "default": {
              "$type": "color",
              "$value": "{core.color.action.tertiary.default}"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.action.tertiary.hover}"
            },
            "pressed": {
              "$type": "color",
              "$value": "{core.color.action.tertiary.pressed}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{component.button.all.container.fill.disabled}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{core.color.border.subtle}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{component.button.all.container.border.disabled}"
            }
          },
          "shadow": {
            "default": {
              "$type": "shadow",
              "$value": "{component.button.tertiary.container.shadow.default}"
            },
            "hover": {
              "$type": "shadow",
              "$value": "{component.button.tertiary.container.shadow.hover}"
            },
            "pressed": {
              "$type": "shadow",
              "$value": "{component.button.tertiary.container.shadow.pressed}"
            },
            "focus": {
              "$type": "shadow",
              "$value": "{component.button.tertiary.container.shadow.focus}"
            },
            "selected": {
              "$type": "shadow",
              "$value": "{component.button.tertiary.container.shadow.pressed}"
            }
          },
          "label": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{component.button.tertiary.label.color.default}"
              },
              "disabled": {
                "$type": "color",
                "$value": "{core.color.content.disabled}"
              }
            }
          }
        },
        "count": {
          "typography": {
            "$type": "typography",
            "$value": "{core.typography.paragraph.2}"
          }
        }
      }
    }
  }
}
